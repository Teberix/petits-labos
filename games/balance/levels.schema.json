{
  "$comment": "ONE level of balance (a parameter set; its rounds are made at play time by weigh.js makeRound). Dev-only (never precached). Either a pairs level (pairs + questions), a count-of-objects level (objects + count + questions) or a cube level (cubes + count + objects). Free mode is not a level: it lives in levels.js (FREE).",
  "type": "object",
  "required": [
    "id",
    "difficulty",
    "rounds"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "enum": [
            "balloon",
            "apple",
            "teddy",
            "pillow",
            "ball",
            "pineapple",
            "stone",
            "watermelon",
            "pumpkin"
          ]
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 3,
      "items": {
        "enum": [
          "balloon",
          "apple",
          "teddy",
          "pillow",
          "ball",
          "pineapple",
          "stone",
          "watermelon",
          "pumpkin"
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "heavy",
          "light"
        ]
      }
    },
    "cubes": {
      "const": true
    },
    "rounds": {
      "type": "integer",
      "minimum": 1
    },
    "intro": {
      "type": "string",
      "pattern": "^balance\\.intro\\.[a-zA-Z]+$"
    }
  }
}
